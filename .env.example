# ===========================================================================
# crypto-trader 환경변수 예시 — 복사해서 .env 로 만들어 사용하세요.
#   cp .env.example .env
# .env 는 절대 커밋하지 마세요 (.gitignore 에 등록됨).
# ===========================================================================

# --- 바이낸스 선물 (테스트넷 권장) ---
# 테스트넷 키 발급: https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# --- 코인글래스 (선택, 없으면 바이낸스 네이티브 데이터로 폴백) ---
# 키 발급: https://www.coinglass.com/pricing
COINGLASS_API_KEY=

# --- 실행 모드 ---
# dry_run : 주문 안 냄, 로그만 (기본, 가장 안전)
# paper   : 테스트넷에 실제 주문 (모의 자금)
# live    : 실전 자금 (⚠️ 매우 주의)
TRADE_MODE=dry_run

# --- 헤지 모드 / 마진 ---
BINANCE_HEDGE_MODE=true       # 한 심볼 롱/숏 동시 보유 (슬리브 방향 독립)
MARGIN_MODE=isolated         # isolated / cross

# --- 매매 대상 / 주기 ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=15m
LOOP_INTERVAL_SEC=60

# --- 리스크 파라미터 ---
MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=1.0       # 1회 매매당 계좌의 몇 % 리스크 (position_margin_pct=0 일 때만)
MAX_OPEN_POSITIONS=10        # 동시 보유 최대 포지션 수
MAX_POSITION_NOTIONAL_PCT=10.0  # 포지션당 명목가치 상한(계좌 %). 리스크 기준 사이징용
POSITION_MARGIN_PCT=10.0     # >0 이면 증거금 기준 사이징(명목=증거금×레버리지). 0=리스크 기준
DAILY_MAX_LOSS_PCT=5.0       # 일일 손실 한도 도달 시 매매 중단

# --- 시그널 / 전략 ---
ENTRY_SCORE_THRESHOLD=0.5     # 합산 점수 절대값이 이 값 이상이면 진입
EXIT_FLIP_THRESHOLD=0.4       # 반대 시그널 강도 이 값 이상이면 조기 청산
ATR_STOP_MULT=1.5             # 손절 거리 = ATR × 이 값
REWARD_RISK_RATIO=1.5         # 익절 = 손절거리 × 이 값 (R배수)

# --- 알림 (텔레그램, 선택) ---
# 봇 생성: 텔레그램에서 @BotFather 검색 → /newbot → 토큰 발급
# chat_id 확인: 봇과 대화 시작 후 https://api.telegram.org/bot<토큰>/getUpdates 의 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MIN_LEVEL=TRADE       # INFO / TRADE / WARN / ERROR (이 레벨 이상만 알림)

# --- 상태 저장 디렉터리 ---
STATE_DIR=state

# --- 로깅 ---
LOG_LEVEL=INFO
